{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuestForge",
  "version": "1.0.6",
  "identifier": "com.questforge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QuestForge",
        "width": 1280,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:questforge.db"
      ]
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/bereza07/QuestSrc/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGNTNEQUUyRTQxMjVCNUEKUldSYVd4TGs0dHBUSDdSdzVLMXZselBpRVEweW5odjI1VFVLVStMYzBLcFpiTE9VMkJiaWV0ajIK"
    }
  }
}