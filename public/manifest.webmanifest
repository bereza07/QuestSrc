{
  "id": "/",
  "name": "QuestForge",
  "short_name": "QuestForge",
  "description": "AI-powered RPG productivity — turn real tasks into a quest.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#111110",
  "theme_color": "#111110",
  "categories": ["productivity", "lifestyle", "utilities"],
  "lang": "en",
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "icons": [
    { "src": "/icon-256.png", "sizes": "256x256", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "Open the main dashboard",
      "url": "/#/",
      "icons": [{ "src": "/icon-256.png", "sizes": "256x256", "type": "image/png" }]
    },
    {
      "name": "Tasks",
      "short_name": "Tasks",
      "description": "Manage your active quests",
      "url": "/#/tasks",
      "icons": [{ "src": "/icon-256.png", "sizes": "256x256", "type": "image/png" }]
    },
    {
      "name": "Assistant",
      "short_name": "Assistant",
      "description": "Talk to the AI Quest Master",
      "url": "/#/assistant",
      "icons": [{ "src": "/icon-256.png", "sizes": "256x256", "type": "image/png" }]
    }
  ]
}
