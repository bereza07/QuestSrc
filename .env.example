# QuestForge environment example
#
# NOTE: The DeepSeek API key is NOT read from this file at runtime.
# It is entered in the app under Settings → AI and stored in OS secure storage
# (encrypted at rest, never written to git, never logged).
#
# This file only documents optional build/dev-time overrides.

# Optional: host for `tauri dev` when testing on another device on your network.
# TAURI_DEV_HOST=192.168.1.50

# Optional defaults used to pre-fill Settings on first run (still overridable in-app).
# These are NON-SECRET defaults only. Do not put an API key here.
VITE_DEFAULT_AI_PROVIDER=deepseek
VITE_DEFAULT_AI_MODEL=deepseek-chat
VITE_DEFAULT_AI_BASE_URL=https://api.deepseek.com
